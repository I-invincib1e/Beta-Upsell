// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Store {
  id           String   @id @default(uuid())
  shopDomain   String   @unique
  accessToken  String?
  plan         String   @default("free")
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Legacy relations (kept for backward compat during Sprint 1)
  offers       Offer[]
  offerEvents  OfferEvent[]

  // New relations
  analytics    AnalyticsDaily[]
  widgets      Widget[]
  funnels      Funnel[]
}

// ============================================================
// NEW MODELS — FunnelX Rework
// ============================================================

model Widget {
  id          String   @id @default(cuid())
  storeId     String
  type        String   // "product_upsell" | "cross_sell" | "bundle" | "discount_timer" | "order_bump" | etc.
  name        String   @default("Untitled Widget")
  config      Json     // widget-specific settings (product, discount, copy, style)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store  Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  steps  FunnelStep[]

  @@index([storeId])
}

model Funnel {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  status       String   @default("draft") // "draft" | "active" | "paused"
  triggerType  String   // "product" | "cart_value" | "collection" | "all"
  triggerValue Json?    // e.g. { productIds: [...] } or { minCartValue: 50 }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  steps    FunnelStep[]
  abTests  AbTest[]

  @@index([storeId])
  @@index([storeId, status])
}

model FunnelStep {
  id         String   @id @default(cuid())
  funnelId   String
  widgetId   String
  placement  String   // "checkout" | "post_purchase" | "thank_you" | "order_status" | "product_page" | "cart"
  position   Int      // order in funnel (0-indexed)
  config     Json?    // step-level overrides on top of widget config

  funnel  Funnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  widget  Widget  @relation(fields: [widgetId], references: [id])

  @@index([funnelId])
}

model AbTest {
  id          String    @id @default(cuid())
  funnelId    String
  name        String
  status      String    @default("running") // "running" | "paused" | "concluded"
  variantA    Json      // widget config snapshot
  variantB    Json      // widget config snapshot
  splitPct    Int       @default(50) // % traffic to variant A
  startedAt   DateTime  @default(now())
  concludedAt DateTime?

  funnel  Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId])
}

// ============================================================
// LEGACY MODELS — Kept for backward compat during Sprint 1
// Will be dropped after data migration is complete.
// ============================================================

model Offer {
  id                String   @id @default(uuid())
  storeId           String
  name              String
  type              String   // post_purchase, checkout, cart, product_page
  triggerType       String   @default("SPECIFIC_PRODUCTS") // SPECIFIC_PRODUCTS, SPECIFIC_COLLECTIONS, ALL_PRODUCTS
  triggerProductIds String[] // Array of product or collection IDs
  upsellProductIds  String[] // Array of upsell product IDs
  conditions        Json     @default("{}") // DEAD FIELD — nothing reads it. Kept for migration safety.
  discountType      String   // percentage, fixed_amount
  discountValue     Float
  isActive          Boolean  @default(true)
  priority          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  store             Store    @relation(fields: [storeId], references: [id])
  offerEvents       OfferEvent[]
  analytics         AnalyticsDaily[]
}

model OfferEvent {
  id                   String   @id @default(uuid())
  storeId              String
  offerId              String
  orderId              String?
  customerId           String?
  eventType            String   // shown, accepted, declined
  upsellRevenue        Float    @default(0.0)
  originalOrderValue   Float    @default(0.0)
  sessionData          Json     @default("{}")
  createdAt            DateTime @default(now())

  store                Store    @relation(fields: [storeId], references: [id])
  offer                Offer    @relation(fields: [offerId], references: [id])
}

// ============================================================
// ANALYTICS — Updated with funnel/step/variant scoping
// ============================================================

model AnalyticsDaily {
  id                   String   @id @default(uuid())
  storeId              String
  offerId              String?  // Legacy: links to Offer. Null for funnel-only events.
  date                 DateTime @db.Date
  impressions          Int      @default(0)
  accepts              Int      @default(0)
  declines             Int      @default(0)
  totalUpsellRevenue   Float    @default(0.0)
  avgOrderValueLift    Float    @default(0.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // New fields for funnel-scoped analytics (nullable for backward compat)
  funnelId             String?
  stepId               String?
  variantKey           String?  // "A" | "B" for A/B tracking

  store                Store    @relation(fields: [storeId], references: [id])
  offer                Offer?   @relation(fields: [offerId], references: [id])

  @@unique([storeId, offerId, funnelId, date, variantKey])
  @@index([storeId, date, funnelId])
}
